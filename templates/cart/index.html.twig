{% extends 'base.html.twig' %}
{% import '_icons.html.twig' as ui %}

{% block title %}Panier{% endblock %}

{% block body %}
<div class="mx-auto max-w-6xl px-4 py-8" data-controller="cart">

    <header class="mb-6">
        <h1 class="page-title">Panier</h1>
        <p class="mt-1 font-mono text-[12px] text-fg-2 tnum" data-cart-target="count" aria-live="polite"></p>
    </header>

    {# Squelette : visible seulement si le panier met plus de 300 ms à se charger #}
    <div class="delayed-reveal grid gap-6 lg:grid-cols-[1fr_320px]" data-cart-target="loading" aria-hidden="true">
        <div class="panel flex flex-col gap-4 p-4">
            {% for i in 1..3 %}
                <div class="flex items-center gap-4">
                    <div class="skeleton size-14"></div>
                    <div class="flex flex-1 flex-col gap-2"><div class="skeleton h-3 w-1/2"></div><div class="skeleton h-3 w-1/4"></div></div>
                </div>
            {% endfor %}
        </div>
        <div class="panel h-40 p-4"><div class="skeleton h-full"></div></div>
    </div>

    <div class="dashed flex flex-col items-center gap-3 bg-surface px-6 py-16 text-center" data-cart-target="empty" hidden>
        <span class="text-muted">{{ ui.icon('cart', 40) }}</span>
        <p class="font-medium">Votre panier est vide.</p>
        <p class="text-[13px] text-fg-2">Parcourez le catalogue et ajoutez des articles pour les retrouver ici.</p>
        <a href="{{ path('app_catalog') }}" class="btn btn-primary mt-2">
            Parcourir le catalogue
            {{ ui.icon('arrow-right', 16) }}
        </a>
    </div>

    <div class="grid items-start gap-6 lg:grid-cols-[1fr_320px]" data-cart-target="content" hidden>
        <section aria-labelledby="cart-items-title" class="panel overflow-hidden">
            <div class="flex items-center justify-between border-b border-line bg-subtle px-4 py-2">
                <h2 id="cart-items-title" class="section-label">Articles</h2>
                <button type="button" class="btn btn-ghost btn-sm" data-action="cart#clear">
                    {{ ui.icon('trash', 16) }}
                    Vider le panier
                </button>
            </div>
            <ul data-cart-target="list" class="divide-y divide-line"></ul>
        </section>

        <aside aria-labelledby="cart-summary-title" class="panel flex flex-col gap-4 p-4 lg:sticky lg:top-20">
            <h2 id="cart-summary-title" class="section-label">Récapitulatif</h2>
            <dl class="flex flex-col gap-2">
                <div class="flex justify-between"><dt class="text-fg-2">Sous-total</dt><dd class="tnum" data-cart-target="subtotal"></dd></div>
                <div class="flex justify-between"><dt class="text-fg-2">Livraison</dt><dd class="text-fg-2">Calculée à l'étape suivante</dd></div>
                <div class="mt-2 flex justify-between border-t border-line pt-3 text-[16px] font-semibold">
                    <dt>Total</dt><dd class="tnum" data-cart-target="total"></dd>
                </div>
            </dl>
            {# data-turbo="false" : Turbo envoie les formulaires en fetch, qui ne peut pas suivre une redirection vers le site d'un vrai PSP #}
            <form method="post" action="{{ path('app_order_place') }}" data-turbo="false" data-action="cart#checkout">
                <input type="hidden" name="_token" value="{{ csrf_token('order') }}">
                <button type="submit" class="btn btn-primary btn-lg w-full" aria-describedby="checkout-help" data-cart-target="checkout">
                    {{ ui.icon('credit-card', 20) }}
                    Passer commande
                </button>
            </form>
            <p id="checkout-help" class="flex items-start gap-2 rounded-md bg-info-bg p-3 text-[13px] text-info">
                {{ ui.icon('info', 16, 'mt-0.5') }}
                Vous serez redirigé vers la page de paiement sécurisé. Votre panier est enregistré : vous le retrouverez lors de votre prochaine visite.
            </p>
        </aside>
    </div>

    <template data-cart-target="template">
        <li class="flex flex-wrap items-center gap-x-4 gap-y-3 px-4 py-3 hover:bg-subtle">
            <span class="grid size-14 shrink-0 place-items-center rounded-sm border border-line bg-subtle text-muted">
                {{ ui.icon('package', 20) }}
            </span>
            <div class="min-w-0 flex-1">
                <a data-field="name" class="block truncate font-semibold hover:text-link"></a>
                <p data-field="price" class="tnum text-[13px] text-fg-2"></p>
            </div>

            <div class="flex items-center gap-4">
                <div>
                    <label data-field="label" class="sr-only"></label>
                    <div class="flex h-9 items-center rounded-md border border-line bg-surface">
                        <span class="inline-flex">
                            <button type="button" class="btn btn-ghost btn-icon h-[34px] w-9 rounded-r-none" data-field="decrement"
                                    data-action="cart#decrement" data-cart-id-param="" aria-label="Diminuer la quantité">
                                {{ ui.icon('minus', 16) }}
                            </button>
                        </span>
                        <input type="number" inputmode="numeric" min="1"
                               class="tnum h-full w-12 border-x border-line bg-transparent text-center outline-none [appearance:textfield] focus-visible:shadow-[var(--focus-ring)] [&::-webkit-inner-spin-button]:appearance-none"
                               data-action="change->cart#change" data-cart-id-param="">
                        <span class="inline-flex">
                            <button type="button" class="btn btn-ghost btn-icon h-[34px] w-9 rounded-l-none" data-field="increment"
                                    data-action="cart#increment" data-cart-id-param="" aria-label="Augmenter la quantité">
                                {{ ui.icon('plus', 16) }}
                            </button>
                        </span>
                    </div>
                </div>
                <span data-field="total" class="tnum w-24 text-right font-semibold"></span>
                <button type="button" class="btn btn-ghost btn-icon btn-sm hover:text-danger" data-field="remove"
                        data-action="cart#remove" data-cart-id-param="" data-tooltip="Retirer">
                    {{ ui.icon('trash', 16) }}
                </button>
            </div>
        </li>
    </template>

</div>
{% endblock %}
