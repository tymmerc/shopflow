{% extends 'base.html.twig' %}

{% block title %}Catalogue{% endblock %}

{% block body %}
<main class="mx-auto max-w-6xl px-4 py-10">

    <h1 class="mb-8 text-3xl font-bold text-slate-900">Catalogue</h1>

    {% if articles is empty %}
        <p class="rounded-lg bg-slate-100 p-6 text-center text-slate-600">
            Aucun article pour le moment.
        </p>
    {% else %}
        <ul class="grid gap-6 sm:grid-cols-2 lg:grid-cols-3">
            {% for article in articles %}
                <li class="flex flex-col overflow-hidden rounded-2xl bg-white shadow-md">
                    {% if article.img %}
                        <img src="{{ article.img }}" alt="{{ article.name }}" class="h-48 w-full object-cover">
                    {% else %}
                        <div class="flex h-48 items-center justify-center bg-slate-100 text-sm text-slate-400">
                            Pas d'image
                        </div>
                    {% endif %}

                    <div class="flex flex-1 flex-col gap-2 p-5">
                        <h2 class="text-lg font-semibold text-slate-900">{{ article.name }}</h2>

                        {% if article.desc %}
                            <p class="flex-1 text-sm text-slate-600">{{ article.desc }}</p>
                        {% endif %}

                        <div class="mt-3 flex items-center justify-between">
                            <span class="text-xl font-bold text-indigo-600">
                                {{ article.price|number_format(2, ',', ' ') }} €
                            </span>

                            {% if article.stock > 0 %}
                                <span class="rounded-full bg-green-100 px-3 py-1 text-xs font-medium text-green-700">
                                    {{ article.stock }} en stock
                                </span>
                            {% else %}
                                <span class="rounded-full bg-red-100 px-3 py-1 text-xs font-medium text-red-700">
                                    Rupture de stock
                                </span>
                            {% endif %}
                        </div>
                    </div>
                </li>
            {% endfor %}
        </ul>
    {% endif %}

</main>
{% endblock %}
