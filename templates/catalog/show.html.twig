{% extends 'base.html.twig' %}
{% import '_icons.html.twig' as ui %}

{% block title %}{{ article.name }}{% endblock %}
{% block meta_description %}{{ article.desc ?? article.name }}{% endblock %}

{% block body %}
{% set out = article.stock <= 0 %}
<div class="mx-auto max-w-6xl px-4 py-8">

    <nav aria-label="Fil d'Ariane" class="mb-6 flex items-center gap-1 text-[13px] text-fg-2">
        <a href="{{ path('app_catalog') }}" class="btn btn-ghost btn-sm -ml-2">
            {{ ui.icon('arrow-left', 16) }}
            Catalogue
        </a>
        {% if article.category %}
            <span class="text-muted">{{ ui.icon('chevron-right', 16) }}</span>
            <a href="{{ path('app_catalog', { categorie: article.category }) }}" class="link">{{ article.category }}</a>
        {% endif %}
        <span class="text-muted">{{ ui.icon('chevron-right', 16) }}</span>
        <span class="truncate text-fg" aria-current="page">{{ article.name }}</span>
    </nav>

    <div class="grid gap-8 md:grid-cols-2">
        <div class="panel product-photo grid aspect-square place-items-center overflow-hidden text-muted md:sticky md:top-20 md:self-start">
            {% if article.img %}
                <img src="{{ article.img }}" alt="{{ article.name }}" class="size-full object-contain p-6" width="900" height="600">
            {% else %}
                <div class="flex flex-col items-center gap-2">
                    {{ ui.icon('package', 40) }}
                    <span class="text-[13px]">Aucune photo pour cet article</span>
                </div>
            {% endif %}
        </div>

        <div class="flex flex-col gap-6"
             data-controller="add-to-cart"
             data-add-to-cart-id-value="{{ article.id }}"
             data-add-to-cart-name-value="{{ article.name }}"
             data-add-to-cart-price-value="{{ article.price }}"
             data-add-to-cart-stock-value="{{ article.stock }}"
             data-add-to-cart-url-value="{{ path('app_catalog_show', { id: article.id }) }}"
             data-add-to-cart-cart-url-value="{{ path('app_cart') }}">
            <div class="flex flex-col gap-3">
                {% if article.level or article.solderingRequired is not null %}
                    <p class="flex flex-wrap items-center gap-2">
                        {% if article.level %}<span class="badge badge-neutral">Niveau {{ article.level|lower }}</span>{% endif %}
                        {% if article.solderingRequired is not null %}
                            <span class="badge badge-neutral">{{ article.solderingRequired ? 'Soudure nécessaire' : 'Sans soudure' }}</span>
                        {% endif %}
                    </p>
                {% endif %}
                <h1 class="page-title text-[24px]">{{ article.name }}</h1>
                {% if article.tagline %}
                    <p class="text-[15px] text-fg">{{ article.tagline }}</p>
                {% endif %}
                <div class="flex flex-wrap items-center gap-3">
                    <span class="tnum text-[24px] font-semibold">{{ article.price|number_format(2, ',', ' ') }}&nbsp;€</span>
                    {{ include('partials/_stock_badge.html.twig', { stock: article.stock }) }}
                </div>
            </div>

            <section class="flex flex-col gap-4">
                <h2 class="section-label">Commande</h2>

                <div class="flex flex-wrap items-end gap-3">
                    <div data-controller="stepper">
                        <label for="qty" class="field-label">Quantité</label>
                        <div class="flex h-11 items-center rounded-md border border-line bg-surface">
                            <span class="inline-flex">
                                <button type="button" class="btn btn-ghost btn-icon h-[42px] w-11 rounded-r-none"
                                        data-stepper-target="decrement" data-action="stepper#decrement"
                                        aria-label="Diminuer la quantité" {% if out %}disabled{% endif %}>
                                    {{ ui.icon('minus', 16) }}
                                </button>
                            </span>
                            <input id="qty" type="number" inputmode="numeric" min="1" max="{{ max(article.stock, 1) }}" value="1"
                                   class="tnum h-full w-14 border-x border-line bg-transparent text-center outline-none [appearance:textfield] focus-visible:shadow-[var(--focus-ring)] [&::-webkit-inner-spin-button]:appearance-none"
                                   data-stepper-target="input" data-add-to-cart-target="quantity"
                                   data-action="change->stepper#clamp"
                                   {% if out %}disabled{% endif %}>
                            <span class="inline-flex">
                                <button type="button" class="btn btn-ghost btn-icon h-[42px] w-11 rounded-l-none"
                                        data-stepper-target="increment" data-action="stepper#increment"
                                        aria-label="Augmenter la quantité" {% if out %}disabled{% endif %}>
                                    {{ ui.icon('plus', 16) }}
                                </button>
                            </span>
                        </div>
                    </div>

                    <span class="inline-flex flex-1" {% if out %}data-tooltip="Article en rupture de stock"{% endif %}>
                        <button type="button" class="btn btn-primary btn-lg w-full min-w-[220px]"
                                data-add-to-cart-target="button" data-action="add-to-cart#add"
                                {% if out %}disabled{% endif %}>
                            {{ ui.icon('cart', 20) }}
                            <span data-add-to-cart-target="label">Ajouter au panier</span>
                        </button>
                    </span>
                </div>

                <p class="field-help font-mono tnum">RÉF. SF-{{ '%05d'|format(article.id) }} · {{ out ? 'réassort en cours' : article.stock ~ ' en stock, expédié sous 24 h ouvrées' }}</p>
                <p class="text-[12px] text-fg-2">Paiement sécurisé · Expédition suivie · Confirmation par e-mail</p>
            </section>

            {% if article.compatibility %}
                <section class="flex flex-col gap-2">
                    <h2 class="section-label">Compatible avec</h2>
                    <ul class="flex flex-wrap gap-2">
                        {% for item in article.compatibility %}
                            <li class="chip chip-static">{{ item }}</li>
                        {% endfor %}
                    </ul>
                </section>
            {% endif %}

            {% if accessories %}
                {{ include('catalog/_accessories.html.twig', { accessories: accessories }) }}
            {% endif %}

        </div>
    </div>

    <div class="mt-10 grid gap-8 md:grid-cols-2">
        {% if article.specs %}
            <section aria-labelledby="specs-title">
                <h2 id="specs-title" class="section-label mb-3">Caractéristiques</h2>
                <dl class="spec-table">
                    {% for spec in article.specs %}
                        <div><dt>{{ spec[0] }}</dt><dd>{{ spec[1] }}</dd></div>
                    {% endfor %}
                </dl>
            </section>
        {% endif %}

        <div class="flex flex-col gap-8">
            {% if article.desc %}
                <section aria-labelledby="desc-title">
                    <h2 id="desc-title" class="section-label mb-3">Description</h2>
                    <p class="max-w-[75ch] text-fg-2">{{ article.desc }}</p>
                </section>
            {% endif %}
            {% if article.boxContents %}
                <section aria-labelledby="box-title">
                    <h2 id="box-title" class="section-label mb-3">Dans la boîte</h2>
                    <ul class="list-disc pl-5 text-fg-2">
                        {% for item in article.boxContents %}<li>{{ item }}</li>{% endfor %}
                    </ul>
                </section>
            {% endif %}
        </div>
    </div>

    {% if related %}
        <section class="mt-12" aria-labelledby="related-title">
            <h2 id="related-title" class="section-label mb-4">Dans la même catégorie</h2>
            <ul class="product-grid">
                {% for item in related %}
                    {{ include('partials/_product_card.html.twig', { article: item }) }}
                {% endfor %}
            </ul>
        </section>
    {% endif %}

</div>
{% endblock %}
