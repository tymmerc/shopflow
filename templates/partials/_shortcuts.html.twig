{% import '_icons.html.twig' as ui %}
{% set shortcuts = {
    'Général': [
        { keys: ['⌘', 'K'], mod: true, label: 'Ouvrir la palette de commandes' },
        { keys: ['?'], label: 'Afficher cette aide' },
        { keys: ['Échap'], label: 'Fermer une fenêtre ou un menu' },
    ],
    'Catalogue': [
        { keys: ['/'], label: 'Filtrer les articles' },
        { keys: ['⌘', 'F'], mod: true, label: 'Filtrer les articles' },
        { keys: ['←', '→'], label: 'Changer la vue (grille / liste)' },
    ],
    'Listes': [
        { keys: ['↑', '↓'], label: 'Naviguer dans les résultats' },
        { keys: ['↵'], label: 'Ouvrir la sélection' },
    ],
} %}

<dialog id="shortcuts" class="modal" aria-labelledby="shortcuts-title"
        data-controller="dialog"
        data-action="dialog:open@window->dialog#openFromEvent click->dialog#backdropClose close->dialog#restoreFocus">
    <div class="flex items-center justify-between border-b border-line px-4 py-3">
        <h2 id="shortcuts-title" class="text-[14px] font-semibold">Raccourcis clavier</h2>
        <button type="button" class="btn btn-ghost btn-icon btn-sm" data-action="dialog#close" aria-label="Fermer">
            {{ ui.icon('x', 16) }}
        </button>
    </div>
    <div class="flex flex-col gap-6 p-4">
        {% for group, items in shortcuts %}
            <section>
                <h3 class="section-label mb-2">{{ group }}</h3>
                <dl class="flex flex-col">
                    {% for s in items %}
                        <div class="flex min-h-8 items-center justify-between gap-4">
                            <dt class="text-fg-2">{{ s.label }}</dt>
                            <dd class="flex gap-1">
                                {% for k in s.keys %}
                                    <kbd class="kbd" {% if s.mod is defined and loop.first %}data-mod-key{% endif %}>{{ k }}</kbd>
                                {% endfor %}
                            </dd>
                        </div>
                    {% endfor %}
                </dl>
            </section>
        {% endfor %}
    </div>
</dialog>
