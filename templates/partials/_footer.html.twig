{% import '_icons.html.twig' as ui %}
<footer class="border-t border-line bg-subtle">
    <div class="mx-auto flex min-h-9 max-w-6xl flex-wrap items-center justify-between gap-x-4 gap-y-1 px-4 py-2 text-[12px] text-fg-2">
        <p class="flex items-center gap-3">
            <span>© {{ 'now'|date('Y') }} ShopFlow</span>
            <span class="font-mono tracking-[0.08em]">SHOPFLOW · V.0.1.0</span>
        </p>
        <button type="button" class="btn btn-ghost btn-sm"
                data-action="shell#open" data-shell-dialog-param="shortcuts" aria-keyshortcuts="Shift+?">
            {{ ui.icon('keyboard', 16) }}
            Raccourcis clavier
            <kbd class="kbd">?</kbd>
        </button>
    </div>
</footer>
