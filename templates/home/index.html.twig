{% extends 'base.html.twig' %}
{% import '_icons.html.twig' as ui %}

{% block title %}Accueil{% endblock %}

{% block body %}
{# Fond d'ambiance réservé à l'accueil (§2.5) #}
<section class="ambient border-b border-line">
    <div class="mx-auto flex max-w-6xl flex-col items-start gap-6 px-4 py-16 sm:py-24">
        <p class="section-label w-full max-w-xs">Boutique en ligne</p>
        <h1 class="brand max-w-2xl text-[28px] leading-tight">
            Composants électroniques et kits robotiques
        </h1>
        <p class="max-w-[60ch] text-[15px] text-fg-2">
            Trouvez les pièces de votre prochain montage, ajoutez-les au panier et suivez votre commande
            jusqu'à la livraison.
        </p>
        <div class="flex flex-wrap items-center gap-3">
            <a href="{{ path('app_catalog') }}" class="btn btn-primary btn-lg">
                Parcourir le catalogue
                {{ ui.icon('arrow-right', 16) }}
            </a>
            <button type="button" class="btn btn-secondary btn-lg"
                    data-action="shell#open" data-shell-dialog-param="palette">
                {{ ui.icon('search', 16) }}
                Rechercher
                <kbd class="kbd" data-mod-key>⌘K</kbd>
            </button>
        </div>
    </div>
</section>

<div class="mx-auto flex max-w-6xl flex-col gap-12 px-4 py-12">
    {% if categories %}
        <section aria-labelledby="categories-title">
            <h2 id="categories-title" class="section-label mb-4">Rayons</h2>
            <ul class="flex flex-wrap gap-2">
                {% for name, total in categories %}
                    <li>
                        <a href="{{ path('app_catalog', { categorie: name }) }}" class="chip">
                            {{ name }} <span class="chip-count tnum">{{ total }}</span>
                        </a>
                    </li>
                {% endfor %}
            </ul>
        </section>
    {% endif %}

    <section aria-labelledby="latest-title">
        <h2 id="latest-title" class="section-label mb-4">
            Nouveautés
            <a href="{{ path('app_catalog') }}" class="section-label-end link inline-flex items-center gap-1 text-[13px] font-medium">
                Tout voir {{ ui.icon('arrow-right', 16) }}
            </a>
        </h2>

        {% if latest is empty %}
            <div class="dashed flex flex-col items-center gap-3 bg-surface px-6 py-12 text-center">
                <span class="text-muted">{{ ui.icon('package', 40) }}</span>
                <p class="font-medium">Aucun article pour le moment.</p>
                <p class="text-[13px] text-fg-2">Les nouveautés apparaîtront ici dès leur mise en ligne.</p>
            </div>
        {% else %}
            <ul class="product-grid">
                {% for article in latest %}
                    {{ include('partials/_product_card.html.twig', { article: article }) }}
                {% endfor %}
            </ul>
        {% endif %}
    </section>

    <section aria-labelledby="why-title">
        <h2 id="why-title" class="section-label mb-4">Commander sereinement</h2>
        <ul class="grid gap-3 sm:grid-cols-3">
            {% for item in [
                { icon: 'shield-check', title: 'Paiement sécurisé', text: 'Le règlement passe par un prestataire de paiement externe : vos données bancaires ne transitent pas par la boutique.' },
                { icon: 'truck', title: 'Livraison suivie', text: 'Chaque commande est confiée à un transporteur, avec un suivi jusqu\'à votre porte.' },
                { icon: 'mail', title: 'Confirmation par e-mail', text: 'Un récapitulatif vous est envoyé dès que le paiement est validé.' },
            ] %}
                <li class="panel flex flex-col gap-2 p-4">
                    <span class="grid size-9 place-items-center rounded-md bg-selected text-heading">{{ ui.icon(item.icon, 20) }}</span>
                    <h3 class="mt-1 font-semibold">{{ item.title }}</h3>
                    <p class="text-[13px] text-fg-2">{{ item.text }}</p>
                </li>
            {% endfor %}
        </ul>
    </section>
</div>
{% endblock %}
