{% extends 'base.html.twig' %}

{% block title %}Crédits photos{% endblock %}

{% block body %}
<div class="mx-auto max-w-3xl px-4 py-8">
    <h1 class="page-title">Crédits photos</h1>
    <p class="mt-2 text-[13px] text-fg-2">
        Les photos des produits viennent de Wikimedia Commons. Elles ont été redimensionnées pour le site
        et restent sous leur licence d'origine.
    </p>

    <ul class="mt-6 flex flex-col divide-y divide-[var(--border)] rounded-md border border-line bg-surface">
        {% for credit in credits %}
            <li class="flex items-center gap-4 px-4 py-3 text-[13px]">
                <img src="/images/products/{{ credit.file }}" alt="" class="size-12 shrink-0 rounded-sm border border-line bg-white object-contain p-0.5" loading="lazy">
                <div class="min-w-0 flex-1">
                    <a href="{{ credit.source }}" class="link font-medium" rel="noopener" target="_blank">{{ credit.title }}</a>
                    <p class="text-fg-2">
                        {{ credit.author ?: 'Auteur inconnu' }} ·
                        {% if credit.license_url %}<a href="{{ credit.license_url }}" class="link" rel="noopener license" target="_blank">{{ credit.license }}</a>{% else %}{{ credit.license }}{% endif %}
                    </p>
                </div>
            </li>
        {% else %}
            <li class="px-4 py-3 text-fg-2">Aucun crédit à afficher.</li>
        {% endfor %}
    </ul>
</div>
{% endblock %}
